# Copy to .env.local and fill in. Never commit real values.

# --- App -------------------------------------------------------------------
# Public base URL, e.g. https://your-domain.tld (used for metadata, sitemap, auth redirects)
NEXT_PUBLIC_APP_URL=

# --- Supabase (auth + database) --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI --------------------------------------------------------------------
# "development" (default; returns insufficient_data, no AI calls) or "openai"
AI_PROVIDER=
OPENAI_API_KEY=
# Vision-capable model id; defaults to gpt-4o-mini when empty
OPENAI_MODEL=

# --- Stripe (phase 9) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# --- Displayed plan prices (PROPOSAL until approved by the owner) ----------
# Must match the Stripe prices once Stripe is connected. Empty = defaults in lib/config/plans.ts
NEXT_PUBLIC_PLAN_CURRENCY=
NEXT_PUBLIC_PLAN_PRICE_PRO=
NEXT_PUBLIC_PLAN_PRICE_PREMIUM=

# --- Analytics (only after cookie consent) ---------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
# Reserved for server-side analytics in later phases
ANALYTICS_KEY=

# --- Uploads ---------------------------------------------------------------
# Max upload size in MB (default 8)
MAX_UPLOAD_MB=
# Days after which uploaded images are deleted (default 30)
IMAGE_RETENTION_DAYS=
