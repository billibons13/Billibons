{
 "name": "TG-Leads DE — 1. Lead Hunter + Verification (Freelancer.com → LH-03)",
 "metadata": {
  "instant": false,
  "version": 1,
  "scenario": {
   "dlq": false,
   "dataloss": false,
   "maxErrors": 3,
   "autoCommit": true,
   "roundtrips": 1,
   "sequential": true,
   "confidential": false,
   "autoCommitTriggerLast": true
  }
 },
 "flow": [
  {
   "id": 1,
   "module": "http:ActionSendData",
   "version": 3,
   "parameters": {
    "handleErrors": false,
    "useNewZLibDeCompress": true
   },
   "mapper": {
    "qs": [
     {
      "name": "currency_codes[]",
      "value": "EUR"
     }
    ],
    "url": "https://www.freelancer.com/api/projects/0.1/currencies/",
    "gzip": true,
    "method": "get",
    "headers": [
     {
      "name": "User-Agent",
      "value": "TGLeadsDE/1.0 (Make.com; contact: owner)"
     }
    ],
    "useMtls": false,
    "serializeUrl": false,
    "shareCookies": false,
    "parseResponse": true,
    "followRedirect": true,
    "useQuerystring": false,
    "followAllRedirects": false,
    "rejectUnauthorized": true
   },
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0
    }
   }
  },
  {
   "id": 2,
   "module": "http:ActionSendData",
   "version": 3,
   "parameters": {
    "handleErrors": false,
    "useNewZLibDeCompress": true
   },
   "mapper": {
    "qs": [],
    "url": "https://www.freelancer.com/api/projects/0.1/projects/active/?jobs[]=2380&jobs[]=2068&jobs[]=2918&jobs[]=2917&jobs[]=2823&project_types[]=fixed&project_types[]=hourly&limit=50&full_description=true&compact=true&from_time={{formatDate(addHours(now; -12); \"X\")}}",
    "gzip": true,
    "method": "get",
    "headers": [
     {
      "name": "User-Agent",
      "value": "TGLeadsDE/1.0 (Make.com; contact: owner)"
     }
    ],
    "useMtls": false,
    "serializeUrl": false,
    "shareCookies": false,
    "parseResponse": true,
    "followRedirect": true,
    "useQuerystring": false,
    "followAllRedirects": false,
    "rejectUnauthorized": true
   },
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0
    }
   }
  },
  {
   "id": 3,
   "module": "builtin:BasicFeeder",
   "version": 1,
   "mapper": {
    "array": "{{2.data.result.projects}}"
   },
   "parameters": {},
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0
    }
   }
  },
  {
   "id": 6,
   "module": "datastore:GetRecord",
   "version": 1,
   "mapper": {
    "key": "fl-{{3.id}}",
    "returnWrapped": false
   },
   "parameters": {
    "datastore": 205357
   },
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0
    }
   },
   "filter": {
    "name": "fixed ≥300 € или hourly ≥15 €/ч",
    "conditions": [
     [
      {
       "a": "{{3.type}}",
       "o": "text:equal",
       "b": "fixed"
      },
      {
       "a": "{{round(3.budget.maximum * 3.currency.exchange_rate / first(map(1.data.result.currencies; \"exchange_rate\")))}}",
       "o": "number:greaterorequal",
       "b": "300"
      }
     ],
     [
      {
       "a": "{{3.type}}",
       "o": "text:equal",
       "b": "hourly"
      },
      {
       "a": "{{round(3.budget.maximum * 3.currency.exchange_rate / first(map(1.data.result.currencies; \"exchange_rate\")))}}",
       "o": "number:greaterorequal",
       "b": "15"
      }
     ]
    ]
   }
  },
  {
   "id": 7,
   "module": "util:FunctionIncrement",
   "version": 1,
   "mapper": {},
   "parameters": {
    "reset": "execution"
   },
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0
    }
   },
   "filter": {
    "name": "Новый (нет в базе)",
    "conditions": [
     [
      {
       "a": "{{6.source}}",
       "o": "notexist"
      }
     ]
    ]
   }
  },
  {
   "id": 9,
   "module": "datastore:GetRecord",
   "version": 1,
   "mapper": {
    "key": "main",
    "returnWrapped": false
   },
   "parameters": {
    "datastore": 207951
   },
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0
    }
   },
   "filter": {
    "name": "Не больше 5 за запуск",
    "conditions": [
     [
      {
       "a": "{{7.i}}",
       "o": "number:lessorequal",
       "b": "5"
      }
     ]
    ]
   }
  },
  {
   "id": 10,
   "module": "http:ActionSendData",
   "version": 3,
   "mapper": {
    "url": "https://hook.eu1.make.com/i7nnyj1mxyeez4mgznqk6x58oqhinbdr",
    "method": "post",
    "headers": [],
    "qs": [],
    "bodyType": "x_www_form_urlencoded",
    "formFields": [
     {
      "key": "token",
      "value": "{{9.internal_token}}"
     },
     {
      "key": "source",
      "value": "freelancer"
     },
     {
      "key": "source_url",
      "value": "https://www.freelancer.com/projects/{{3.seo_url}}"
     },
     {
      "key": "text",
      "value": "{{3.title}}\nhttps://www.freelancer.com/projects/{{3.seo_url}}\nFreelancer.com · {{if(3.type = \"hourly\"; \"почасовой\"; \"фикс\")}} · бюджет {{3.budget.minimum}}–{{3.budget.maximum}} {{3.currency.code}}{{if(3.type = \"hourly\"; \"/ч\"; \"\")}} (≈ до {{round(3.budget.maximum * 3.currency.exchange_rate / first(map(1.data.result.currencies; \"exchange_rate\")))}} EUR{{if(3.type = \"hourly\"; \"/ч\"; \"\")}}) · ставок: {{ifempty(3.bid_stats.bid_count; 0)}} · язык: {{3.language}}\n\n{{substring(3.description; 0; 3000)}}{{if(length(3.description) > 3000; \"…\"; \"\")}}"
     },
     {
      "key": "text_links",
      "value": "https://www.freelancer.com/projects/{{3.seo_url}}"
     }
    ],
    "parseResponse": false,
    "serializeUrl": false,
    "shareCookies": false,
    "rejectUnauthorized": true,
    "followRedirect": true,
    "followAllRedirects": false,
    "useQuerystring": false,
    "gzip": true,
    "useMtls": false
   },
   "parameters": {
    "handleErrors": true,
    "useNewZLibDeCompress": true
   },
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0
    }
   },
   "onerror": [
    {
     "id": 510,
     "module": "builtin:Ignore",
     "version": 1,
     "mapper": null,
     "metadata": {
      "designer": {
       "x": 0,
       "y": 0
      }
     }
    }
   ]
  },
  {
   "id": 11,
   "module": "datastore:AddRecord",
   "version": 1,
   "mapper": {
    "key": "fl-{{3.id}}",
    "overwrite": false,
    "data": {
     "title": "{{3.title}}",
     "source": "Freelancer.com API",
     "status": "sent_lh03",
     "currency": "{{3.currency.code}}",
     "language": "{{3.language}}",
     "bid_count": "{{ifempty(3.bid_stats.bid_count; 0)}}",
     "posted_at": "{{parseDate(3.time_submitted; \"X\")}}",
     "source_id": "{{3.id}}",
     "budget_max": "{{3.budget.maximum}}",
     "budget_min": "{{3.budget.minimum}}",
     "fetched_at": "{{now}}",
     "source_url": "https://www.freelancer.com/projects/{{3.seo_url}}",
     "description": "{{substring(3.description; 0; 4000)}}",
     "delete_after": "{{addDays(now; 90)}}",
     "project_type": "{{3.type}}",
     "verification": "API: status={{3.status}}, nonpublic={{3.nonpublic}}, deleted={{3.deleted}}; передан в LH-03",
     "budget_max_eur": "{{round(3.budget.maximum * 3.currency.exchange_rate / first(map(1.data.result.currencies; \"exchange_rate\")))}}"
    }
   },
   "parameters": {
    "datastore": 205357
   },
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0
    }
   }
  }
 ]
}