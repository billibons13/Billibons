# Öffentliche Basis-URL (ohne Slash am Ende) – für Canonicals, Sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://www.example.de

# Lead-Ziel: "make" (Standard), "webhook" (beliebiger HTTP-Endpunkt) oder "log" (nur Server-Log, für lokale Entwicklung)
LEAD_SINK=make

# Make.com → Szenario "Lead-Intake" → Modul "Webhooks > Custom webhook" → URL kopieren
MAKE_WEBHOOK_URL=
# Gemeinsames Geheimnis; Make prüft den Header X-Lead-Secret im ersten Filter
MAKE_WEBHOOK_SECRET=

# Nur für LEAD_SINK=webhook
GENERIC_WEBHOOK_URL=
