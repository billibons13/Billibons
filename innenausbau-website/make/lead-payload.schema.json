{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lead-payload-v1",
  "title": "LeadPayload v1.0 (Website → Make)",
  "description": "Inhalt des Multipart-Felds `payload`. Fotos kommen als separate Multipart-Felder file_0 … file_5. Quelle der Wahrheit: src/lib/leads/types.ts",
  "type": "object",
  "required": ["schema_version", "lead_id", "timestamp", "name", "phone", "location", "project_type", "services", "consent", "meta"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "lead_id": { "type": "string", "pattern": "^L-\\d{8}-[0-9a-f]{8}$", "examples": ["L-20261002-2e467793"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "name": { "type": "string", "maxLength": 120 },
    "phone": { "type": "string", "maxLength": 40 },
    "email": { "type": "string", "description": "Leer, wenn nicht angegeben" },
    "location": { "type": "string", "maxLength": 120 },
    "project_type": { "enum": ["Wohnung", "Haus", "Büro", "Gewerbe"] },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["Komplettrenovierung", "Badsanierung", "Küchenrenovierung", "Trockenbau", "Innenputz", "Spachtelarbeiten", "Malerarbeiten", "Bodenbeläge", "Fliesenarbeiten", "Decken & Wände", "Sanierung", "Sonstiges"]
      }
    },
    "area": { "type": "string", "description": "m², Freitext" },
    "budget": { "enum": ["", "Keine Angabe", "unter 10.000 €", "10.000–25.000 €", "25.000–50.000 €", "50.000–100.000 €", "über 100.000 €"] },
    "preferred_date": { "enum": ["", "So schnell wie möglich", "In 1–3 Monaten", "In 3–6 Monaten", "Später / noch offen"] },
    "message": { "type": "string", "maxLength": 3000 },
    "uploaded_files": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["field", "name", "type", "size"],
        "properties": {
          "field": { "type": "string", "pattern": "^file_[0-5]$" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "size": { "type": "integer" }
        }
      }
    },
    "consent": {
      "type": "object",
      "required": ["given", "text_version", "timestamp"],
      "properties": {
        "given": { "const": true },
        "text_version": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "source": { "const": "website" },
        "source_page": { "type": "string" },
        "utm": { "type": "object", "additionalProperties": { "type": "string" } },
        "user_agent": { "type": "string" },
        "locale": { "type": "string" }
      }
    }
  }
}
