{
 "name": "Klaus Affiliate Hunter — 1. Intake (Prüfung, Dedup, Speichern, Queue)",
 "metadata": {
  "instant": true,
  "version": 1,
  "scenario": {
   "dlq": false,
   "dataloss": false,
   "maxErrors": 3,
   "autoCommit": true,
   "roundtrips": 1,
   "sequential": false,
   "confidential": false,
   "autoCommitTriggerLast": true
  }
 },
 "flow": [
  {
   "id": 1,
   "module": "gateway:CustomWebHook",
   "version": 1,
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0
    }
   },
   "parameters": {
    "hook": 3820339,
    "maxResults": 1
   },
   "mapper": {}
  },
  {
   "id": 7,
   "module": "util:SetVariables",
   "version": 1,
   "metadata": {
    "designer": {
     "x": 300,
     "y": 0
    }
   },
   "parameters": {},
   "mapper": {
    "variables": [
     {
      "name": "valid",
      "value": "{{if(1.product_id; if(1.product_name; if(indexOf(ifempty(1.product_url; \"\"); \"http\") = 0; \"1\"; \"0\"); \"0\"); \"0\")}}"
     },
     {
      "name": "verified",
      "value": "{{if(1.affiliate_status = \"verified\"; if(indexOf(ifempty(1.affiliate_url; \"\"); \"https://\") = 0; \"1\"; \"0\"); \"0\")}}"
     },
     {
      "name": "queue",
      "value": "{{if(if(1.affiliate_status = \"verified\"; if(indexOf(ifempty(1.affiliate_url; \"\"); \"https://\") = 0; \"1\"; \"0\"); \"0\") = \"1\"; if(1.commercial_priority = \"A\"; \"1\"; if(1.commercial_priority = \"B\"; \"1\"; \"0\")); \"0\")}}"
     }
    ],
    "scope": "roundtrip"
   }
  },
  {
   "id": 10,
   "module": "builtin:BasicRouter",
   "version": 1,
   "metadata": {
    "designer": {
     "x": 600,
     "y": 0
    }
   },
   "mapper": null,
   "routes": [
    {
     "flow": [
      {
       "id": 2,
       "module": "datastore:GetRecord",
       "version": 1,
       "metadata": {
        "designer": {
         "x": 900,
         "y": -150
        }
       },
       "parameters": {
        "datastore": 203568
       },
       "mapper": {
        "key": "{{1.product_id}}",
        "returnWrapped": false
       },
       "filter": {
        "name": "Pflichtfelder ok",
        "conditions": [
         [
          {
           "a": "{{7.valid}}",
           "o": "text:equal",
           "b": "1"
          }
         ]
        ]
       }
      },
      {
       "id": 3,
       "module": "datastore:AddRecord",
       "version": 1,
       "metadata": {
        "designer": {
         "x": 1200,
         "y": -150
        }
       },
       "parameters": {
        "datastore": 203568
       },
       "mapper": {
        "key": "{{1.product_id}}",
        "overwrite": true,
        "data": {
         "product_id": "{{1.product_id}}",
         "product_name": "{{1.product_name}}",
         "brand": "{{1.brand}}",
         "category": "{{1.category}}",
         "market": "DE",
         "store": "{{1.store}}",
         "product_url": "{{1.product_url}}",
         "affiliate_url": "{{if(7.verified = \"1\"; 1.affiliate_url; \"\")}}",
         "affiliate_network": "{{1.affiliate_network}}",
         "affiliate_status": "{{if(7.verified = \"1\"; \"verified\"; if(1.affiliate_status = \"verified\"; \"unverified\"; ifempty(1.affiliate_status; \"unverified\")))}}",
         "price_eur": "{{1.price_eur}}",
         "commission_percent": "{{1.commission_percent}}",
         "estimated_commission_eur": "{{1.estimated_commission_eur}}",
         "cookie_duration_days": "{{1.cookie_duration_days}}",
         "availability": "{{ifempty(1.availability; \"unknown\")}}",
         "source_url": "{{1.source_url}}",
         "video_category": "{{1.video_category}}",
         "matching_klaus_scenario": "{{1.matching_klaus_scenario}}",
         "video_hook": "{{1.video_hook}}",
         "commercial_priority": "{{if(7.verified = \"1\"; ifempty(1.commercial_priority; \"C\"); \"HOLD\")}}",
         "score": "{{1.score}}",
         "epm_base_eur": "{{1.epm_scenarios.base}}",
         "disclosure_text": "{{1.disclosure_text}}",
         "compliance_flags": "{{join(1.compliance_flags; \", \")}}",
         "discovered_at": "{{ifempty(2.discovered_at; ifempty(1.discovered_at; formatDate(now; \"YYYY-MM-DD\")))}}",
         "verification_date": "{{1.verification_date}}",
         "link_status": "{{ifempty(1.link_status; ifempty(2.link_status; \"unchecked\"))}}",
         "last_update": "{{now}}",
         "make_status": "{{if(2.product_id; \"updated\"; \"created\")}}",
         "content_queue": "{{if(7.queue = \"1\"; true; false)}}",
         "video_status": "{{if(ifempty(2.video_status; \"none\") = \"none\"; if(7.queue = \"1\"; \"queued\"; \"none\"); 2.video_status)}}",
         "video_url": "{{2.video_url}}",
         "publication_results": "{{2.publication_results}}",
         "views": "{{2.views}}",
         "clicks": "{{2.clicks}}",
         "sales": "{{2.sales}}",
         "confirmed_commission_eur": "{{2.confirmed_commission_eur}}",
         "refunds": "{{2.refunds}}",
         "notes": "{{1.notes}}"
        }
       }
      },
      {
       "id": 4,
       "module": "gateway:WebhookRespond",
       "version": 1,
       "metadata": {
        "designer": {
         "x": 1500,
         "y": -150
        }
       },
       "parameters": {},
       "mapper": {
        "status": 200,
        "body": "{\"ok\": true, \"product_id\": \"{{1.product_id}}\", \"make_status\": \"{{if(2.product_id; \"updated\"; \"created\")}}\", \"affiliate_status\": \"{{if(7.verified = \"1\"; \"verified\"; if(1.affiliate_status = \"verified\"; \"unverified\"; ifempty(1.affiliate_status; \"unverified\")))}}\", \"priority\": \"{{if(7.verified = \"1\"; ifempty(1.commercial_priority; \"C\"); \"HOLD\")}}\", \"content_queue\": {{if(7.queue = \"1\"; \"true\"; \"false\")}}, \"video_status\": \"{{if(ifempty(2.video_status; \"none\") = \"none\"; if(7.queue = \"1\"; \"queued\"; \"none\"); 2.video_status)}}\", \"affiliate_url_stored\": {{if(7.verified = \"1\"; \"true\"; \"false\")}}}",
        "headers": [
         {
          "key": "Content-Type",
          "value": "application/json"
         }
        ]
       }
      },
      {
       "id": 5,
       "module": "telegram:SendReplyMessage",
       "version": 1,
       "metadata": {
        "designer": {
         "x": 1800,
         "y": -150
        }
       },
       "parameters": {
        "__IMTCONN__": 9469273
       },
       "mapper": {
        "chatId": "6883357001",
        "text": "🧰 Klaus Affiliate Hunter — новый товар в очереди контента\n\n{{1.product_name}}{{if(1.brand; \" · \"; \"\")}}{{1.brand}}\nПриоритет: {{1.commercial_priority}} · score {{1.score}}\nЦена: {{ifempty(1.price_eur; \"?\")}} € · комиссия {{ifempty(1.commission_percent; \"?\")}} % ≈ {{ifempty(1.estimated_commission_eur; \"?\")}} € за продажу\nМагазин: {{1.store}} · сеть: {{1.affiliate_network}} · cookie {{ifempty(1.cookie_duration_days; \"?\")}} дн.\nСценарий Klaus: {{ifempty(1.matching_klaus_scenario; \"—\")}}\nHook: {{ifempty(1.video_hook; \"—\")}}\n\nСсылка (проверена {{1.verification_date}}): {{1.affiliate_url}}\nПометка в ролике: {{1.disclosure_text}}\nID: {{1.product_id}}",
        "parseMode": "",
        "disableWebPagePreview": true
       },
       "filter": {
        "name": "Neu in Queue",
        "conditions": [
         [
          {
           "a": "{{7.queue}}",
           "o": "text:equal",
           "b": "1"
          },
          {
           "a": "{{ifempty(2.video_status; \"none\")}}",
           "o": "text:equal",
           "b": "none"
          }
         ]
        ]
       },
       "onerror": [
        {
         "id": 51,
         "module": "builtin:Ignore",
         "version": 1,
         "metadata": {
          "designer": {
           "x": 1800,
           "y": 0
          }
         },
         "mapper": null
        }
       ]
      }
     ]
    },
    {
     "flow": [
      {
       "id": 6,
       "module": "gateway:WebhookRespond",
       "version": 1,
       "metadata": {
        "designer": {
         "x": 900,
         "y": 150
        }
       },
       "parameters": {},
       "mapper": {
        "status": 400,
        "body": "{\"ok\": false, \"error\": \"product_id, product_name und product_url (http…) sind Pflicht\"}",
        "headers": [
         {
          "key": "Content-Type",
          "value": "application/json"
         }
        ]
       },
       "filter": {
        "name": "Pflichtfelder fehlen",
        "conditions": [
         [
          {
           "a": "{{7.valid}}",
           "o": "text:equal",
           "b": "0"
          }
         ]
        ]
       }
      }
     ]
    }
   ]
  }
 ]
}