{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Klaus Affiliate Hunter — статус/статистика (status webhook)",
 "type": "object",
 "required": [
  "product_id"
 ],
 "properties": {
  "product_id": {
   "type": "string"
  },
  "video_status": {
   "enum": [
    "none",
    "queued",
    "in_production",
    "published",
    "rejected"
   ]
  },
  "video_url": {
   "type": "string"
  },
  "publication_results": {
   "type": "string"
  },
  "views": {
   "type": "number"
  },
  "clicks": {
   "type": "number"
  },
  "sales": {
   "type": "number"
  },
  "confirmed_commission_eur": {
   "type": "number"
  },
  "refunds": {
   "type": "number"
  },
  "link_status": {
   "enum": [
    "ok",
    "broken",
    "unchecked"
   ]
  },
  "availability": {
   "enum": [
    "in_stock",
    "out_of_stock",
    "preorder",
    "unknown"
   ]
  },
  "price_eur": {
   "type": "number"
  },
  "verification_date": {
   "type": "string",
   "format": "date"
  },
  "notes": {
   "type": "string"
  }
 },
 "description": "Пустые поля не перезаписывают сохранённые. link_status=broken или out_of_stock снимают товар с очереди."
}